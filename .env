# ============================================================
# 团队公共配置（提交 git，由 TL/管理员维护）
# ============================================================

# GitLab 配置
GITLAB_URL=https://gitlab.xxx.com
GITLAB_PROJECT_ID=xxx
GITLAB_BRANCH_MAIN=main
GITLAB_BRANCH_PRE=pre

# 企业微信 Webhook（研发工作流通知群，用于 MR 创建/合并/更新等）
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 日报专用群 Webhook（发送每日工作日报，建议单独建群@老板）
# 不填则复用上方 WECHAT_WEBHOOK_URL
# WECHAT_DAILY_REPORT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=yyy

# Reviewer 手机号（用于企微@，多个逗号分隔）
WECHAT_AT_TL=13800000001,13800000002

# Reviewer GitLab 用户名（多个逗号分隔）
GITLAB_REVIEWER_USERNAMES=zhangsan,lisi

# 全体成员 GitLab账号 → 手机号映射（新成员入职时追加）
WECHAT_USER_zhangsan=13900000001
WECHAT_USER_lisi=13900000002
WECHAT_USER_wujing03=18800000003

# ============================================================
# LLM 配置（可选，用于 cc gitlab daily-report 日报总结）
# 支持任何 OpenAI-compatible 接口（OpenAI / Azure / 本地模型等）
# 不配置则跳过 LLM，使用内置格式化
# ============================================================
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o-mini
